DEVICE_API_KEY=generate-a-long-random-secret
CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
FIREBASE_SERVICE_ACCOUNT_JSON=<paste-the-complete-service-account-json-on-one-line>
FIRESTORE_DATABASE_ID=(default)
CONFIDENCE_THRESHOLD=0.45
MAX_IMAGE_BYTES=10000000
CORS_ORIGINS=["http://localhost:5173","https://skymatrix-hd.web.app","https://skymatrix-hd.firebaseapp.com"]
